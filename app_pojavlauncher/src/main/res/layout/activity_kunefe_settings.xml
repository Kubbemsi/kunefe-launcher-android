<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kunefe_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/kunefe_settings_title"
            android:textColor="@color/kunefe_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/kunefe_settings_subtitle"
            android:textColor="@color/kunefe_dim"
            android:textSize="13sp" />

        <!-- FPS profili -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_kunefe_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kunefe_settings_fps"
                android:textColor="@color/kunefe_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/kunefe_settings_fps_hint"
                android:textColor="@color/kunefe_dim"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/fps_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/fps_performance"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/kunefe_accent"
                    android:text="@string/kunefe_settings_fps_performance"
                    android:textColor="@color/kunefe_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/fps_balanced"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/kunefe_accent"
                    android:text="@string/kunefe_settings_fps_balanced"
                    android:textColor="@color/kunefe_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/fps_ultra"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/kunefe_accent"
                    android:text="@string/kunefe_settings_fps_ultra"
                    android:textColor="@color/kunefe_text"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Skin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kunefe_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kunefe_settings_skin"
                android:textColor="@color/kunefe_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/kunefe_settings_skin_hint"
                android:textColor="@color/kunefe_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/skin_preview"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_kunefe_input"
                    android:contentDescription="@string/kunefe_settings_skin"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/skin_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/kunefe_settings_skin_none"
                    android:textColor="@color/kunefe_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/skin_pick_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_kunefe_input"
                android:stateListAnimator="@null"
                android:text="@string/kunefe_settings_skin_pick"
                android:textAllCaps="false"
                android:textColor="@color/kunefe_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Modlar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kunefe_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kunefe_settings_mods"
                android:textColor="@color/kunefe_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/kunefe_settings_mods_hint"
                android:textColor="@color/kunefe_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/mods_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_kunefe_button"
            android:stateListAnimator="@null"
            android:text="@string/kunefe_settings_save"
            android:textAllCaps="false"
            android:textColor="#07071A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/save_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/kunefe_online"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/update_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_kunefe_input"
            android:stateListAnimator="@null"
            android:text="@string/kunefe_settings_check_update"
            android:textAllCaps="false"
            android:textColor="@color/kunefe_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/logout_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:text="@string/kunefe_settings_logout"
            android:textAllCaps="false"
            android:textColor="@color/kunefe_offline"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
