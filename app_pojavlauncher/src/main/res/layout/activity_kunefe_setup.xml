<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kunefe_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="@string/kunefe_login_title"
            android:src="@drawable/kunefe_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/kunefe_setup_title"
            android:textColor="@color/kunefe_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/kunefe_setup_subtitle"
            android:textColor="@color/kunefe_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_kunefe_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/phase_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kunefe_setup_starting"
                android:textColor="@color/kunefe_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/setup_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/kunefe_border"
                android:progressTint="@color/kunefe_accent" />

            <TextView
                android:id="@+id/percent_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:text="0%"
                android:textColor="@color/kunefe_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/kunefe_setup_first_run"
                android:textColor="@color/kunefe_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_kunefe_input"
            android:padding="14dp"
            android:textColor="@color/kunefe_offline"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/retry_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kunefe_button"
                android:stateListAnimator="@null"
                android:text="@string/kunefe_setup_retry"
                android:textAllCaps="false"
                android:textColor="#07071A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/skip_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kunefe_input"
                android:stateListAnimator="@null"
                android:text="@string/kunefe_setup_skip"
                android:textAllCaps="false"
                android:textColor="@color/kunefe_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/skip_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/kunefe_setup_skip_warning"
            android:textColor="#5A5F7A"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/kunefe_version"
            android:textColor="#5A5F7A"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
